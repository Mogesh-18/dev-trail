# Public — safe to ship in the client bundle (protected by Supabase RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only — used inside /api serverless functions, never prefixed with
# VITE_ so Vite never bundles them into client code. Set these in the Vercel
# project's Environment Variables, not in this file.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
STUDENT_EMAIL=

# Public — safe in the client bundle
VITE_VAPID_PUBLIC_KEY=

# Server-only — set in Vercel, never commit real values
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com